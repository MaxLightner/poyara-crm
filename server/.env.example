# POYARA text agent: default is the Google Gemini API Free tier.
# Do NOT commit working keys or place GEMINI_API_KEY in the Android APK.
POYARA_TEXT_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=YOUR_GOOGLE_AI_STUDIO_KEY
POYARA_VOICE_TOKEN=REPLACE_WITH_RANDOM_32_PLUS_CHARACTER_PAIRING_SECRET

# PAID OPTIONAL fallback: only if POYARA_TEXT_PROVIDER=openai is explicitly set.
# OPENAI_API_KEY=YOUR_PAID_OPENAI_API_KEY
# POYARA_EXTRACTION_MODEL=gpt-6-luna

# /v1/voice/analyze is an older optional paid audio endpoint requiring OpenAI.
# For no paid API calls use the Android Google speech-to-text -> /v1/text/analyze path.
